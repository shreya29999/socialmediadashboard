# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# PostgreSQL database connection details.
# Make sure PostgreSQL is installed and running locally.
#
# Example:
#   DB_HOST=localhost
#   DB_PORT=5432
#   DB_NAME=social_dashboard
#   DB_USER=postgres
#   DB_PASSWORD=your_postgres_password

DB_HOST=localhost
DB_PORT=5432
DB_NAME=social_dashboard
DB_USER=postgres
DB_PASSWORD=your_postgres_password


# ============================================================
# REDIS CONFIGURATION
# ============================================================
# Redis is used for caching/background tasks/temporary data.
# Install Redis and make sure it is running on port 6379.
#
# Local Redis:
#   redis://localhost:6379/0

REDIS_URL=redis://localhost:6379/0


# ============================================================
# APPLICATION CONFIGURATION
# ============================================================
# Base URL of the FastAPI application.
#
# If the application runs using:
#   uvicorn app.main:app --host 0.0.0.0 --port 8001
#
# then use:
#   http://localhost:8001

BASE_URL=http://localhost:8001


# ============================================================
# JWT AUTHENTICATION
# ============================================================
# Used to create and validate JWT authentication tokens.
#
# JWT_SECRET_KEY:
# Generate a strong random secret.
#
# Python example:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Never commit the real secret to GitHub.

JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440


# ============================================================
# SMTP / EMAIL CONFIGURATION
# ============================================================
# Gmail SMTP configuration.
#
# For Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#
# SMTP_PASSWORD should normally be a Gmail App Password,
# NOT your normal Gmail account password.
#
# Create an App Password from:
# Google Account -> Security -> 2-Step Verification
# -> App passwords

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_NAME=Social Dashboard


# ============================================================
# META / FACEBOOK CONFIGURATION
# ============================================================
# Create an application from Meta for Developers.
#
# You need:
#   META_APP_ID
#   META_APP_SECRET
#   META_REDIRECT_URI
#
# Configure the same callback URL inside your Meta Developer
# application.
#
# Local callback:
#   http://localhost:8001/auth/facebook/callback

META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:8001/auth/facebook/callback


# ============================================================
# INSTAGRAM CONFIGURATION
# ============================================================
# Instagram integration uses the Meta/Instagram application
# credentials.
#
# Obtain this value from your Meta Developer application.

INSTAGRAM_APP_SECRET=your_instagram_app_secret


# ============================================================
# LINKEDIN OAUTH CONFIGURATION
# ============================================================
# Create an application in LinkedIn Developer Portal.
#
# Configure the following redirect URL in the LinkedIn app:
#   http://localhost:8001/auth/linkedin/callback
#
# Documentation:
# https://learn.microsoft.com/en-us/linkedin/

LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8001/auth/linkedin/callback


# ============================================================
# CLOUDINARY CONFIGURATION
# ============================================================
# Cloudinary is used for cloud media/file storage.
#
# Create an account at:
# https://cloudinary.com/
#
# Find these values in:
# Cloudinary Dashboard -> Product Environment Credentials

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# ============================================================
# GROQ AI CONFIGURATION
# ============================================================
# Used for AI/LLM functionality.
#
# Create an API key from the Groq console.

GROQ_API_KEY=your_groq_api_key


# ============================================================
# CALENDARIFIC CONFIGURATION
# ============================================================
# Used for calendar/holiday related functionality.
#
# Create an API key from Calendarific.

CALENDARIFIC_API_KEY=your_calendarific_api_key


# ============================================================
# POLLINATIONS AI CONFIGURATION
# ============================================================
# Used for Pollinations AI functionality if enabled
# by the application.

POLLINATIONS_API_KEY=your_pollinations_api_key